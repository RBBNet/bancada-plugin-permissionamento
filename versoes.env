# Versões fixadas de tudo o que a bancada usa. Mudar aqui = mudar o experimento.

# Besu dos nós na fase inicial (última versão com permissionamento on-chain nativo)
BESU_VERSAO_INICIAL=25.5.0
BESU_IMAGEM_INICIAL=hyperledger/besu:25.5.0@sha256:607e5dd4c90bd4fcd6d0d8ff2e5da51c93079cc25c69b694287d88823476c43d

# Repositórios da RBB usados pelo roteiro (commits exatos)
START_NETWORK_REPO=https://github.com/RBBNet/start-network.git
START_NETWORK_COMMIT=b2aa320fa8ff7f2fa5c85a30894787146751f433
PERMISSIONAMENTO_REPO=https://github.com/RBBNet/Permissionamento.git
PERMISSIONAMENTO_COMMIT=cc21f2535b806b946545e463f893fe6ce69b224a
SCRIPTS_PERMISSIONAMENTO_REPO=https://github.com/RBBNet/scripts-permissionamento.git
SCRIPTS_PERMISSIONAMENTO_COMMIT=0ff058483b3e1457d59c373a80ade8b63c98376a

# Ferramentas
YARN_VERSAO=1.22.22
NODE_VERSAO_MINIMA=20

# Besu do nó migrado para o plugin (o plugin v1.0.0-rc.1 é compilado contra a 25.12.0)
BESU_VERSAO_PLUGIN=25.12.0
BESU_IMAGEM_PLUGIN=hyperledger/besu:25.12.0@sha256:4ef9e934bb321d916ff245981fd65100dc41446b26b2bed47a2b7d09139a3cbe

# Plugin de permissionamento on-chain (jar do release; o SHA-256 é o publicado pelo GitHub para o asset)
PLUGIN_VERSAO=v1.0.0-rc.1
PLUGIN_URL=https://github.com/RBBNet/besu-permissioning-plugin/releases/download/v1.0.0-rc.1/besu-plugin-permissioning.jar
PLUGIN_SHA256=5d7eebac3de229fd5940fe919a9535c8aeab2be5108dc1bd2231a07ba33955bd

# Issues abertas no repositório do plugin para defeitos reproduzidos pela bancada (preencher ao abrir)
ISSUE_PLUGIN_NODERULES_GENESIS="RBBNet/besu-permissioning-plugin#2"
